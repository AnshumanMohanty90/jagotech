{
  "name": "Lead",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "work_email": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "company_size": {
      "type": "string"
    },
    "main_task": {
      "type": "string"
    },
    "plan_of_interest": {
      "type": "string"
    },
    "intent": {
      "type": "string",
      "enum": [
        "plan",
        "trial",
        "enterprise",
        "guide",
        "pricing"
      ]
    },
    "source_page": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "work_email",
    "company",
    "main_task",
    "intent"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}